{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "request_id",
    "phase",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "warmup",
        "steady"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "elapsed_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "first_text_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ttft_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tpot_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "itl_ms": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  }
}
